<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SolucionBase.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link href="<%= ResolveUrl("~/plugins/fontawesome-free/css/all.min.css") %>" rel="stylesheet" />

    <!-- AdminLTE y plugins -->
    <link rel="stylesheet" href="<%= ResolveUrl("~/Dist/css/adminlte.min.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/bower_components/select2/dist/css/select2.min.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/bower_components/toastr/toastr.min.css") %>" />
    <!-- CSS Personalizado -->
    <%--<link rel="stylesheet" href="<%= ResolveUrl("~/Dist/css/custom.css") %>" />--%>
    <link href="<%= ResolveUrl("~/SiteMaster.css") %>" rel="stylesheet" />


    <!-- Ajuste visual de Select2 para AdminLTE / Bootstrap -->
    <style type="text/css">
        /* Iguala la altura y bordes al diseño de Bootstrap / AdminLTE */
        .select2-container .select2-selection--single {
            height: calc(2.25rem + 2px) !important; /* Altura estándar de form-control */
            padding: 0.375rem 0.75rem;
            border: 1px solid #ced4da !important;
            border-radius: 0.25rem !important;
        }

        /* Centra el texto verticalmente */
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 1.5 !important;
            padding-left: 0 !important;
            color: #495057;
        }

        /* Ubica la flecha desplegable correctamente */
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 100% !important;
            right: 8px !important;
        }

        /* Asegura que ocupe el 100% del ancho del contenedor */
        .select2-container {
            width: 100% !important;
        }
    </style>

    <title><%: Page.Title %></title>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <form id="form1" runat="server">

        <!-- MODAL GLOBAL DE ERRORES / VALIDACIONES -->
        <div class="modal fade" id="modalErrorValidacion" tabindex="-1" role="dialog" aria-labelledby="modalErrorLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content border-danger">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="modalErrorLabel">
                            <i class="fas fa-exclamation-triangle mr-2"></i>Atención / Errores de Validación
                        </h5>
                        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <!-- Aquí se inyectará dinámicamente el mensaje de error -->
                        <div id="lblContenidoModalError" class="text-dark">
                            <!-- Mensaje -->
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Entendido</button>
                    </div>
                </div>
            </div>
        </div>


        <div class="wrapper">
            <asp:ScriptManager ID="ScriptManager1" runat="server" ScriptMode="Release" EnablePageMethods="true" OnAsyncPostBackError="ScriptManager1_AsyncPostBackError" AllowCustomErrorsRedirect="true">
                <Scripts>
                    <%-- jQuery 3 --%>
                    <%--<asp:ScriptReference Path="~/bower_components/jquery/dist/jquery.min.js" />--%>
                    <%-- Bootstrap 3.3.7 --%>
                    <%--<asp:ScriptReference Path="~/bower_components/bootstrap/dist/js/bootstrap.min.js" />--%>
                    <%-- SlimScroll -->
<asp:ScriptReference Path="~/bower_components/jquery-slimscroll/jquery.slimscroll.min.js" />
<%-- FastClick --%>
                    <asp:ScriptReference Path="~/bower_components/fastclick/lib/fastclick.js" />
                    <%-- toastr --%>
                    <asp:ScriptReference Path="~/bower_components/toastr/toastr.min.js" />
                    <%-- AdminLTE App --%>
                    <asp:ScriptReference Path="~/dist/js/adminlte.min.js" />
                    <%-- AdminLTE for demo purposes --%>
                    <%--<asp:ScriptReference Path="~/dist/js/demo.js" />--%>
                    <%-- General --%>
                    <asp:ScriptReference Path="~/dist/js/general.js" />
                    <%-- ErrorAjaxHandler --%>
                    <asp:ScriptReference Path="~/dist/js/ErrorAjaxHandler.js" />
                    <%-- Cookie --%>
                    <asp:ScriptReference Path="~/dist/js/jquery.cookie.js" />
                </Scripts>
            </asp:ScriptManager>

            <!-- Navbar -->
            <!-- Navbar Superior Corregido -->
            <!-- Navbar Superior sin paddings laterales -->
            <nav class="main-header navbar navbar-expand navbar-dark pr-0" style="background-color: #00bcd4;">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                    </li>
                </ul>

                <!-- Right navbar links -->
                <ul class="navbar-nav ml-auto pr-0 mr-0">
                    <li class="nav-item dropdown user-menu pr-0 mr-0">
                        <a href="#" class="nav-link dropdown-toggle text-white font-weight-bold d-flex align-items-center pr-2" data-toggle="dropdown" id="userDropdown">
                            <i class="fas fa-user-circle fa-lg mr-1"></i>
                            <span>
                                <asp:Literal ID="LTR_NavRightButtonName" runat="server"></asp:Literal></span>
                        </a>

                        <!-- Tarjeta forzada con posicionamiento inline -->
                        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right shadow-lg border-0 rounded-lg overflow-hidden p-0"
                            style="position: absolute !important; right: 0 !important; left: auto !important; top: 100% !important; margin-right: 0 !important; transform: none !important;">

                            <div class="user-header text-white text-center p-4" style="background-color: #00bcd4;">
                                <i class="fas fa-user-circle fa-4x mb-2 opacity-75"></i>
                                <h5 class="font-weight-bold mb-1 text-white">
                                    <asp:Literal ID="LTR_NavRightName" runat="server"></asp:Literal>
                                </h5>
                                <span class="badge badge-light text-dark px-2 py-1 font-weight-normal">Nivel:
                                    <asp:Literal ID="LTR_NavRightNivel" runat="server"></asp:Literal>
                                </span>
                            </div>

                            <div class="user-body bg-white p-3">
                                <div class="row text-secondary small">
                                    <div class="col-12 mb-1">
                                        <i class="fas fa-briefcase text-info mr-2"></i>
                                        <strong>Cargo:</strong>
                                        <span class="text-dark">
                                            <asp:Literal ID="LTR_NavRightCargo" runat="server"></asp:Literal></span>
                                    </div>
                                    <div class="col-12">
                                        <i class="fas fa-map-marker-alt text-info mr-2"></i>
                                        <strong>Destino:</strong>
                                        <span class="text-dark">
                                            <asp:Literal ID="LTR_NavRightDestino" runat="server"></asp:Literal></span>
                                    </div>
                                </div>
                            </div>

                            <div class="user-footer bg-light p-3 border-top text-center">
                                <asp:HyperLink ID="HL_Cerrar" runat="server" CssClass="btn btn-outline-danger btn-block font-weight-bold shadow-sm" NavigateUrl="~/CerrarSesion.aspx">
                        <i class="fas fa-sign-out-alt mr-1"></i> Cerrar Sesión
                                </asp:HyperLink>
                            </div>

                        </div>
                    </li>
                </ul>
            </nav>
            <!-- Main Sidebar Container -->
            <aside class="main-sidebar sidebar-dark-primary elevation-4" style="background-color: #262c35;">
                <!-- Brand Logo -->
                <asp:HyperLink ID="LK_Logo" NavigateUrl="~/Default" runat="server" CssClass="brand-link" Style="background-color: #00bcd4;">
                    <span class="brand-text font-weight-light pl-2">
                        <asp:Literal ID="LTR_TitleSystem" runat="server"></asp:Literal>
                    </span>
                </asp:HyperLink>

                <!-- Sidebar -->
                <div class="sidebar">
                    <!-- User Panel -->
                    <div class="user-panel mt-3 pb-3 mb-3 d-flex flex-column">
                        <div class="info text-white">
                            <p class="d-block mb-1 font-weight-bold">
                                <asp:Literal ID="LTR_SideName" runat="server"></asp:Literal>
                            </p>
                            <p class="small mb-1 text-muted">
                                <asp:Literal ID="LTR_SideCargo" runat="server" /><br />
                                <asp:Literal ID="LTR_SideDestino" runat="server" />
                            </p>
                            <span class="badge badge-info">NIVEL:
                                <asp:Literal ID="LTR_SideNivel" runat="server"></asp:Literal>
                            </span>
                        </div>
                        <div class="sidebar-footer">
                            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="true">
                               <li class="nav-item">
                                   <asp:LinkButton ID="BtnCerrarSession" runat="server" CssClass="nav-link cerrarSesionMenu" OnClick="BtnCerrarSession_Click">
                                       <i class="nav-icon fa fa-lock"></i><p>Cerrar Sesión</p>
                                   </asp:LinkButton>
                               </li> 

                            </ul>
                            
                        </div>
                    </div>

                    <!-- Sidebar Menu -->
                    <nav class="mt-2">
                        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="true">
                            <asp:Literal ID="LTR_Sidebar" runat="server"></asp:Literal>
                        </ul>
                    </nav>
                </div>
            </aside>

            <!-- Content Wrapper -->
            <div class="content-wrapper">
                <section class="content-header">
                    <div class="container-fluid">
                        <div class="row mb-2">
                            <div class="col-sm-6">
                                <h1>
                                    <asp:Literal ID="LTR_PageTitle" runat="server" /></h1>
                            </div>
                            <div class="col-sm-6">
                                <ol class="breadcrumb float-sm-right">
                                    <asp:Literal ID="LRT_Breadcrumb" runat="server"></asp:Literal>
                                </ol>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="content">
                    <div class="container-fluid">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                    </div>
                </section>
            </div>

            <!-- Footer -->
            <footer class="main-footer">
                <div class="float-right d-none d-sm-block">
                    <asp:Literal ID="LTL_NombreSistema" runat="server"></asp:Literal>
                    &copy;
                    <asp:Literal ID="LTL_anio" runat="server"></asp:Literal><br />
                    <small class="text-info">DESARROLLADO POR DIEGO A. RODRIGUEZ</small>
                </div>
                <strong>Sistema de Gestión</strong>
            </footer>
        </div>

        <!-- Scripts limpios y unificados al final del formulario -->
        <!-- 1. jQuery SIEMPRE PRIMERO -->
        <script src="<%= ResolveUrl("~/plugins/jquery/jquery.min.js") %>"></script>

        <!-- 2. Bootstrap Bundle (incluye Popper) -->
        <script src="<%= ResolveUrl("~/plugins/bootstrap/js/bootstrap.bundle.min.js") %>"></script>

        <!-- 3. Select2 y Toastr -->
        <script src="<%= ResolveUrl("~/bower_components/select2/dist/js/select2.min.js") %>"></script>
        <script src="<%= ResolveUrl("~/bower_components/toastr/toastr.min.js") %>"></script>

        <!-- 4. Plugins que dependen de jQuery (como las cookies) -->
        <script src="<%= ResolveUrl("~/dist/js/jquery.cookie.js") %>"></script>

        <!-- 5. AdminLTE -->
        <script src="<%= ResolveUrl("~/dist/js/adminlte.min.js") %>"></script>

        <!-- 6. Tus scripts personalizados (CardRefresh, general, etc.) -->
        <%--<script src="<%= ResolveUrl("~/dist/js/CardRefresh.js") %>"></script>--%>
        <script src="<%= ResolveUrl("~/dist/js/general.js") %>"></script>
        <script src="<%= ResolveUrl("~/dist/js/ErrorAjaxHandler.js") %>"></script>
        <script type="text/javascript">
    // @ts-nocheck

    function initSelect2Global() {
        if (typeof $.fn.select2 === 'function') {
            $('.select2, .select2-modal').each(function () {
                var $select = $(this);
                var $modal = $select.closest('.modal');

                // Si el select no está visible y NO está dentro de un modal abierto, lo ignoramos para que no colapse
                if (!$select.is(':visible') && $modal.length === 0) {
                    return;
                }

                // Si ya estaba inicializado, lo destruimos limpiamente antes de re-crearlo
                if ($select.hasClass("select2-hidden-accessible")) {
                    $select.select2('destroy');
                }

                var options = { width: '100%' };
                if ($modal.length > 0) {
                    options.dropdownParent = $modal;
                }

                $select.select2(options);
            });

            // Evento global para enfocar el buscador interno al abrir cualquier Select2
            $(document).off('select2:open.global').on('select2:open.global', function (e) {
                setTimeout(function () {
                    var searchInput = document.querySelector('.select2-container--open .select2-search__field');
                    if (searchInput) {
                        searchInput.focus();
                    }
                }, 50);
            });
        }
    }

   
// Limpieza al cerrar un modal (sin ocultar los selects de la página principal)
$(document).on('hidden.bs.modal', '.modal', function () {
    var $modalActual = $(this);
    $modalActual.find('.select2-modal, .select2').select2('close');
});

    $(document).ready(function () {
        $('#userDropdown').dropdown();
        initSelect2Global();
    });

    // Re-vincula tras recargas parciales de UpdatePanels
    var prm = Sys.WebForms.PageRequestManager.getInstance();
    if (prm) {
        prm.add_endRequest(function () {
            $('#userDropdown').dropdown();
            // Pequeño respiro para que el DOM termine de renderizar los paneles del UpdatePanel
            setTimeout(function () {
                initSelect2Global();
            }, 50);
        });
    }

    window.mostrarMsjValidacion = function (mensaje) {
        var contenedor = document.getElementById('lblContenidoModalError');
        if (contenedor) {
            contenedor.innerHTML = mensaje;
        }
        setTimeout(function () {
            $('#modalErrorValidacion').modal('show');
        }, 100);
    };
        </script>

    </form>
</body>
</html>
